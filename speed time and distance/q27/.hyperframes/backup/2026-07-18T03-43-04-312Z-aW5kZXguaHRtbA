<script>
  apt.setStackLine("#line-g-1", "#stack-given .step-circle", "#stack-step1 .step-circle");
  apt.setStackLine("#line-1-2", "#stack-step1 .step-circle", "#stack-step2 .step-circle");
  apt.setStackLine("#line-2-3", "#stack-step2 .step-circle", "#stack-step3 .step-circle");

  const tl = gsap.timeline({ paused: true });

  // ── PHASE 1 — Question hero reveal
  const HERO_OFFSET_Y = 180;
  const RISE_TIME = 3.6;
  apt.heroEnterLowered(tl, "#q-full-card", HERO_OFFSET_Y, RISE_TIME);

  tl.fromTo("#serial-num",
    { scale: 0, rotation: -45, opacity: 0, y: HERO_OFFSET_Y },
    { scale: 1, rotation: 0, opacity: 1, y: HERO_OFFSET_Y, duration: 0.55, ease: "back.out(2)" },
    0.8);
  tl.to("#serial-num", { y: 0, duration: 0.6, ease: "power2.inOut" }, RISE_TIME);

  // Illustration builds in as each given value is narrated (precise
  // transcript.json word timestamps).
  apt.roadSweep(tl, "#illus-track", 5.859, 0.9);
  tl.fromTo("#illus-track", { opacity: 0 }, { opacity: 1, duration: 0.2 }, 5.859);
  tl.fromTo("#illus-train", { x: -220, scale: 0.7, opacity: 0 }, { x: 0, scale: 1, opacity: 1, duration: 0.7, ease: "back.out(1.6)" }, 5.859);
  tl.fromTo("#illus-train-label", { y: 14, opacity: 0 }, { y: 0, opacity: 1, duration: 0.45, ease: "back.out(2)" }, 8.239);
  tl.fromTo("#illus-speed-tag", { y: -14, opacity: 0 }, { y: 0, opacity: 1, duration: 0.45, ease: "back.out(2)" }, 12.099);
  tl.fromTo("#illus-platform-visual", { x: 220, scale: 0.85, opacity: 0 }, { x: 0, scale: 1, opacity: 1, duration: 0.7, ease: "back.out(1.6)" }, 14.199);
  tl.fromTo("#illus-platform-label", { y: -14, opacity: 0 }, { y: 0, opacity: 1, duration: 0.45, ease: "back.out(2)" }, 15.039);

  // GIVEN card lives in Phase 1 — box appears right as narration starts
  // stating given values (~5.86s = "we are given that the length of the
  // train...") and each line reveals at its own exact value timestamp.
  apt.cardEnter(tl, "#card-given .solution-card", 5.86);
  apt.textReveal(tl, "#card-given .math");

  // ── CONCEPT BEAT — the train physically crosses the platform, then we
  // measure the distance it just covered. This replaces static labels
  // with real motion + a measurement reveal, synced to:
  //   26.039 "When a train crosses a platform,"        → crossing begins
  //   28.059 "it does not cover only its own length."   → still crossing
  //   30.859 "...train plus...platform."                → still crossing / arriving
  //   33.5   (train has fully crossed)                  → measure the span
  const SLIDE_START = 26.039;
  // Train wrap starts at left:80 with its 170px icon centered in a 200px
  // box (so the icon's rear edge sits ~15px inside the wrap). The slide
  // must land that rear edge exactly on the platform's far edge (1180) —
  // i.e. wrap_left + 15 = 1180 → x = (1180 - 15) - 80 = 1085. The earlier
  // value (930) undershot this, leaving the train parked ON TOP of the
  // platform instead of past it.
  const SLIDE_DIST = 1085;
  tl.to("#illus-speed-tag", { opacity: 0, duration: 0.4 }, SLIDE_START);
  tl.to("#illus-train-wrap", { x: SLIDE_DIST, duration: 6.5, ease: "power1.inOut" }, SLIDE_START);

  tl.fromTo("#brace-total", { scaleX: 0, opacity: 0 }, { scaleX: 1, opacity: 1, duration: 0.9, ease: "power3.out" }, 33.5);
  tl.fromTo("#brace-total-tick-l, #brace-total-tick-r", { scaleY: 0, opacity: 0 }, { scaleY: 1, opacity: 1, duration: 0.3, ease: "back.out(2)" }, 34.35);

  // ── PHASE 2 — Pin at 35.4 (right after the measurement settles). The
  // Given card has been visible since 5.86s, so it morphs straight into
  // the stack — no re-entry needed.
  const PIN_TIME = 35.4;

  apt.pinFlow(tl, "#q-full-card", "#q-pinned", PIN_TIME);
  apt.pinFlow(tl, "#illustration", "#illus-pinned", PIN_TIME);
  apt.fadeOut(tl, "#serial-num", PIN_TIME, 0.5);

  apt.morphToStack(tl, "#card-given .solution-card", "#stack-given .stack-card", PIN_TIME);
  apt.cardEnter(tl, "#card-step1 .solution-card", 36.8);
  apt.textReveal(tl, "#card-step1 .math");

  // Pinned illustration would otherwise sit dead-static through Step 1's
  // long ~16s hold — bob its icon through that stretch.
  apt.ambientLoop(tl, "#illus-pinned-icon", 38.5, 53.5);

  // ── Step 1 → stack, Step 2
  apt.morphToStack(tl, "#card-step1 .solution-card", "#stack-step1 .stack-card", 54.1);
  apt.stackLineGrow(tl, "#line-g-1", 54.1);
  apt.cardEnter(tl, "#card-step2 .solution-card", 55.0);
  apt.textReveal(tl, "#card-step2 .math");

  // ── Step 2 → stack, Step 3
  apt.morphToStack(tl, "#card-step2 .solution-card", "#stack-step2 .stack-card", 72.9);
  apt.stackLineGrow(tl, "#line-1-2", 72.9);
  apt.cardEnter(tl, "#card-step3 .solution-card", 73.4);
  apt.textReveal(tl, "#card-step3 .math");

  // ── Recenter — clear stack column before options reveal
  const RECENTER_TIME = 90.0;
  apt.fadeOut(tl, "#illus-pinned", RECENTER_TIME);
  apt.recenterForOptions(tl, "#q-pinned", 160, 180, RECENTER_TIME);

  // ── Step 3 → stack, Options reveal
  apt.morphToStack(tl, "#card-step3 .solution-card", "#stack-step3 .stack-card", RECENTER_TIME);
  apt.stackLineGrow(tl, "#line-2-3", RECENTER_TIME);
  apt.fadeIn(tl, "#options-reveal", 91.0);
  apt.optionsStagger(tl, ".opt-btn", 91.5);
  apt.correctPulse(tl, ".opt-btn.correct", 93.8);

  // ── END FADE
