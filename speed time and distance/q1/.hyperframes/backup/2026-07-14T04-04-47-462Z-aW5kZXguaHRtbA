<script>
  const tl = gsap.timeline({ paused: true });

  // PHASE 1 — Question reveal (starts lowered, rises exactly as the
  // opening narration line ends at 4.34s — "...for this topic.")
  const HERO_OFFSET_Y = 180;
  const RISE_TIME = 4.3;
  apt.heroEnterLowered(tl, "#q-full-card", HERO_OFFSET_Y, RISE_TIME);

  tl.fromTo("#serial-num",
    { scale: 0, rotation: -45, opacity: 0, y: HERO_OFFSET_Y },
    { scale: 1, rotation: 0, opacity: 1, y: HERO_OFFSET_Y, duration: 0.55, ease: "back.out(2)" },
    0.8);
  tl.to("#serial-num", { y: 0, duration: 0.6, ease: "power2.inOut" }, RISE_TIME);

  // Illustration build — road sweeps in, the icon enters, then drifts
  // steadily along the road while the problem is restated (linear, no
  // bounce — represents continuous travel, not a punctual entrance).
  apt.roadSweep(tl, "#road", 4.6);
  apt.cardEnter(tl, "#courier", 5.0);
  tl.to("#courier", { x: 880, duration: 9.1, ease: "none" }, 5.3);

  // Distance/time labels land exactly on the words that name them.
  apt.fadeIn(tl, "#dist-label", 9.34);
  apt.fadeIn(tl, "#time-label", 10.56);

  // PHASE 2 — Pin, then Given (two SEPARATE timestamps).
  const PIN_TIME = 14.78;
  const GIVEN_TIME = 17.76;

  apt.pinFlow(tl, "#q-full-card", "#q-pinned", PIN_TIME);
  apt.pinFlow(tl, "#illustration", "#illus-pinned", PIN_TIME);
  apt.fadeOut(tl, "#serial-num", PIN_TIME, 0.5);

  // Ambient bob on the pinned icon — keeps the pinned area alive through
  // the long Given/Step1/Step2 stretch.
  apt.ambientLoop(tl, "#courier-pinned-icon", PIN_TIME + 1.7, 66.6);

  apt.cardEnter(tl, "#card-given .solution-card", GIVEN_TIME);
  apt.textReveal(tl, "#card-given .math");

  // STEP 1 — morph Given card into Given stack (0.8s).
  apt.morphToStack(tl, "#card-given .solution-card", "#stack-given .stack-card", 22.3);
  apt.cardEnter(tl, "#card-step1 .solution-card", 23.1);
  apt.textReveal(tl, "#card-step1 .math");

  // STEP 2 — Step 1 joins the stack: grow the G→1 connector line.
  apt.morphToStack(tl, "#card-step1 .solution-card", "#stack-step1 .stack-card", 42.1);
  apt.stackLineGrow(tl, "#line-g-1", 42.1);
  apt.cardEnter(tl, "#card-step2 .solution-card", 42.9);
  apt.textReveal(tl, "#card-step2 .math");

  // ── Recenter — clear the stack column before options reveal.
  const RECENTER_TIME = 66.9;
  apt.fadeOut(tl, "#illus-pinned", RECENTER_TIME);
  apt.recenterForOptions(tl, "#q-pinned", 160, 180, RECENTER_TIME);

  // PHASE 3 — Options reveal — Step 2 joins the stack: grow the 1→2 line.
  apt.morphToStack(tl, "#card-step2 .solution-card", "#stack-step2 .stack-card", 66.1);
  apt.stackLineGrow(tl, "#line-1-2", 66.1);
  apt.fadeIn(tl, "#options-reveal", 67.4);
  apt.optionsStagger(tl, ".opt-btn", 67.9);
  apt.correctPulse(tl, ".opt-btn.correct", 71.5);

  // ── END FADE — everything fades out together, once, after the correct
  // pulse and narration have both settled (narration ends 72.24s). Selecting
  // every direct child of #root fades the background layers, pinned
  // question, stack column, and options grid as one synchronized beat
  // rather than each element cutting separately.
  const END_FADE_TIME = 72.9;
  apt.fadeOut(tl, "#root > div", END_FADE_TIME, 1.2);

  tl.set({},{},76.5)

  window.__timelines = window.__timelines || {};
  window.__timelines["root"] = tl;
</script>
