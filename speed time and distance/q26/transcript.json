{
  "duration": 63.919,
  "phrases": [
    {
      "start": 0.119,
      "end": 0.259,
      "text": "So"
    },
    {
      "start": 0.919,
      "end": 1.699,
      "text": "welcome back again."
    },
    {
      "start": 2.159,
      "end": 3.759,
      "text": "Time for one more problem."
    },
    {
      "start": 4.199,
      "end": 5.019,
      "text": "Now, in this problem,"
    },
    {
      "start": 5.519,
      "end": 6.48,
      "text": "we are given that"
    },
    {
      "start": 6.92,
      "end": 7.98,
      "text": "a train covers"
    },
    {
      "start": 8.539,
      "end": 9.819,
      "text": "three hundred kilometers"
    },
    {
      "start": 10.3,
      "end": 11.219,
      "text": "in five hours,"
    },
    {
      "start": 11.619,
      "end": 13.079,
      "text": "including all the stoppages."
    },
    {
      "start": 13.559,
      "end": 14.519,
      "text": "Its running speed is"
    },
    {
      "start": 14.979,
      "end": 15.699,
      "text": "seventy-five"
    },
    {
      "start": 16.26,
      "end": 17.239,
      "text": "kilometer per hour."
    },
    {
      "start": 17.94,
      "end": 20.92,
      "text": "The question is asking us to find the total stoppage time."
    },
    {
      "start": 21.459,
      "end": 22.0,
      "text": "Now, first,"
    },
    {
      "start": 22.379,
      "end": 27.319,
      "text": "let us find the actual running time taken by train to cover three hundred kilometers."
    },
    {
      "start": 27.799,
      "end": 28.639,
      "text": "We know the formula."
    },
    {
      "start": 29.179,
      "end": 32.239,
      "text": "Time is equal to distance divided by speed."
    },
    {
      "start": 32.779,
      "end": 33.7,
      "text": "Putting the values,"
    },
    {
      "start": 34.119,
      "end": 37.5,
      "text": "running time is equal to three hundred divided by seventy-five."
    },
    {
      "start": 38.0,
      "end": 39.219,
      "text": "This gives us four hours."
    },
    {
      "start": 39.639,
      "end": 41.459,
      "text": "Now that we know the actual running time,"
    },
    {
      "start": 41.86,
      "end": 43.779,
      "text": "finding the stoppage time becomes very easy."
    },
    {
      "start": 44.34,
      "end": 45.959,
      "text": "The total journey took five hours,"
    },
    {
      "start": 46.399,
      "end": 48.999,
      "text": "but the train was actually moving for only four hours."
    },
    {
      "start": 49.419,
      "end": 51.679,
      "text": "So the remaining time must be the stoppage time."
    },
    {
      "start": 52.159,
      "end": 54.939,
      "text": "Stoppage time is equal to total time minus running time."
    },
    {
      "start": 55.259,
      "end": 56.84,
      "text": "That is equal to five minus four."
    },
    {
      "start": 57.319,
      "end": 61.279,
      "text": "This gives us one hour. So the total stoppage time is one hour."
    },
    {
      "start": 61.619,
      "end": 63.919,
      "text": "Hence, the correct answer is option C."
    }
  ],
