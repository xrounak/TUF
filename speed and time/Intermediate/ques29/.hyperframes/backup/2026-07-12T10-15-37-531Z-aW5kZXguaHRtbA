<script>
  const tl = gsap.timeline({ paused: true });

  tl.set("#plane-icon", { x: 0, y: 0, data: "hf-hold" }, 0);

  // PHASE 1 — Question reveal
  const HERO_OFFSET_Y = 180;
  const RISE_TIME = 3.6;
  apt.heroEnterLowered(tl, "#q-full-card", HERO_OFFSET_Y, RISE_TIME);

  tl.fromTo("#serial-num",
    { scale: 0, rotation: -45, opacity: 0, y: HERO_OFFSET_Y },
    { scale: 1, rotation: 0, opacity: 1, y: HERO_OFFSET_Y, duration: 0.55, ease: "back.out(2)" },
    0.8);
  tl.to("#serial-num", { y: 0, duration: 0.6, ease: "power2.inOut" }, RISE_TIME);

  // Illustration builds phrase by phrase
  apt.fadeIn(tl, "#illustration", 4.3);
  apt.fadeIn(tl, "#speed-chip", 11.74);
  tl.to("#plane-icon", { keyframes: { "0%": { x: 0, y: 0 }, "100%": { x: -15 }, easeEach: "power2.out" }, duration: 1.5, ease: "none" }, 14.88);
  apt.fadeIn(tl, "#clock-chip", 18.40);

  // PHASE 2 — Pin, then Given
  const PIN_TIME = 19.6;
  const GIVEN_TIME = 24.68;

  apt.pinFlow(tl, "#q-full-card", "#q-pinned", PIN_TIME);
  apt.pinFlow(tl, "#illustration", "#illus-pinned", PIN_TIME);

  apt.cardEnter(tl, "#card-given .solution-card", GIVEN_TIME);
  apt.textReveal(tl, "#card-given .math");

  // STEP 1
  apt.morphToStack(tl, "#card-given .solution-card", "#stack-given .stack-card", 29.5);
  apt.cardEnter(tl, "#card-step1 .solution-card", 30.5);
  apt.textReveal(tl, "#card-step1 .math");

  // STEP 2
  apt.morphToStack(tl, "#card-step1 .solution-card", "#stack-step1 .stack-card", 57.70);
  apt.stackLineGrow(tl, "#line-g-1", 57.70);
  apt.cardEnter(tl, "#card-step2 .solution-card", 58.70);
  apt.textReveal(tl, "#card-step2 .math");

  // STEP 3
  apt.morphToStack(tl, "#card-step2 .solution-card", "#stack-step2 .stack-card", 83.60);
  apt.stackLineGrow(tl, "#line-1-2", 83.60);
  apt.cardEnter(tl, "#card-step3 .solution-card", 84.60);
  apt.textReveal(tl, "#card-step3 .math");

  // STEP 4 — final answer card (never joins the stack)
  apt.morphToStack(tl, "#card-step3 .solution-card", "#stack-step3 .stack-card", 95.50);
  apt.stackLineGrow(tl, "#line-2-3", 95.50);
  apt.cardEnter(tl, "#card-step4 .solution-card", 96.50);
  apt.textReveal(tl, "#card-step4 .math");

  // Recenter — clear illustration + Step4 card, align pinned question with options column
  const RECENTER_TIME = 102.2;
  apt.fadeOut(tl, "#illus-pinned", RECENTER_TIME);
  apt.cardExit(tl, "#card-step4 .solution-card", RECENTER_TIME);
