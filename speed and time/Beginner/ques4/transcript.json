{
  "duration": 78.779,
  "phrases": [
    {
      "start": 0.099,
      "end": 1.36,
      "text": "So welcome back"
    },
    {
      "start": 1.699,
      "end": 1.959,
      "text": "again."
    },
    {
      "start": 2.419,
      "end": 2.919,
      "text": "Time for"
    },
    {
      "start": 3.559,
      "end": 4.5,
      "text": "one more problem."
    },
    {
      "start": 5.099,
      "end": 5.92,
      "text": "Now in this problem,"
    },
    {
      "start": 6.379,
      "end": 8.72,
      "text": "a boy walks at eight kilometers per hour."
    },
    {
      "start": 9.3,
      "end": 12.519,
      "text": "If he walks at 12 kilometers per hour for the same time,"
    },
    {
      "start": 12.92,
      "end": 15.019,
      "text": "he can walk 16 kilometers more."
    },
    {
      "start": 15.539,
      "end": 18.42,
      "text": "The question is asking us to find the actual distance"
    },
    {
      "start": 18.879,
      "end": 20.739,
      "text": "traveled at eight kilometers per hour."
    },
    {
      "start": 21.359,
      "end": 24.139,
      "text": "Let us take the actual distance as X kilometers."
    },
    {
      "start": 24.68,
      "end": 28.099,
      "text": "Then the distance at the higher speed will be X plus 16 kilometers."
    },
    {
      "start": 28.579,
      "end": 29.959,
      "text": "Here we are sure about one fact,"
    },
    {
      "start": 30.459,
      "end": 32.239,
      "text": "the time is the same in both cases."
    },
    {
      "start": 32.799,
      "end": 35.7,
      "text": "We know that time is equal to distance divided by speed."
    },
    {
      "start": 36.259,
      "end": 38.179,
      "text": "So the time in the first case is"
    },
    {
      "start": 38.5,
      "end": 39.539,
      "text": "X divided by eight."
    },
    {
      "start": 39.959,
      "end": 43.759,
      "text": "The time in the second case is X plus 16 divided by 12."
    },
    {
      "start": 44.279,
      "end": 45.579,
      "text": "Since both times are equal,"
    },
    {
      "start": 45.919,
      "end": 50.159,
      "text": "we get X divided by eight equal to X plus 16 divided by 12."
    },
    {
      "start": 50.52,
      "end": 50.899,
      "text": "Got it?"
    },
    {
      "start": 51.399,
      "end": 51.759,
      "text": "Perfect."
    },
    {
      "start": 52.18,
      "end": 53.239,
      "text": "Now we cross-multiply."
    },
    {
      "start": 53.639,
      "end": 60.559,
      "text": "We get 12x equal to eight multiplied by X plus 16. After opening the bracket, we get 12x equal to"
    },
    {
      "start": 60.859,
      "end": 62.52,
      "text": "8x plus 128."
    },
    {
      "start": 62.959,
      "end": 64.419,
      "text": "After simplifying this,"
    },
    {
      "start": 64.72,
      "end": 66.86,
      "text": "4x is equal to 128."
    },
    {
      "start": 67.419,
      "end": 68.419,
      "text": "So X is equal to"
    },
    {
      "start": 68.739,
      "end": 69.119,
      "text": "32."
    },
    {
      "start": 69.619,
      "end": 69.959,
      "text": "Hence,"
    },
    {
      "start": 70.459,
      "end": 72.419,
      "text": "the actual distance traveled is"
    },
    {
      "start": 72.779,
      "end": 73.739,
      "text": "32 kilometers."
    },
    {
      "start": 74.239,
      "end": 78.779,
      "text": "So the final answer will be option D, 32 kilometers"
    }
  ],
