<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<link rel="stylesheet" href="design-system.css">
<style>
  .car {
    position: relative;
    width: 220px;
    height: 110px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .car svg { width: 180px; height: 80px; }
  .car .data-label {
    font-family: var(--font);
    font-weight: 400;
    font-size: 29px;
    color: var(--primary);
    text-align: center;
    opacity: 0;
    line-height: 1.3;
  }
  .car .q-label {
    font-family: var(--font);
    font-weight: 500;
    font-size: 34px;
    color: var(--primary);
    text-align: center;
    opacity: 0;
  }
  .ratio-chip {
    font-family: var(--font);
    font-weight: 400;
    font-size: 30px;
    color: #FFFFFF;
    background: var(--primary);
    padding: 10px 26px;
    border-radius: var(--radius-pill);
    opacity: 0;
  }
</style>
</head>
<body>
<div data-hf-id="hf-89uj" id="root" data-composition-id="root" data-start="0" data-width="1920" data-height="1080">

  <!-- ══════ BACKGROUND LAYERS (always visible) ══════ -->
  <div data-hf-id="hf-858h" class="dotted-grid"></div>
  <div data-hf-id="hf-izuk" class="bottom-strip"></div>
  <div data-hf-id="hf-2918" class="topic-name">Speed and Time</div>
  <div data-hf-id="hf-e319" class="logo"></div>

  <!-- ══════ VOICEOVER ══════ -->
  <audio data-hf-id="hf-41fn" id="voiceover" class="clip" src="voiceover.mp3" data-start="0" data-duration="57.7" data-track-index="0"></audio>

  <!-- ══════════════════════════════════════════════
       PHASE 1 — Question + Illustration (0–14.5s)
       ══════════════════════════════════════════════ -->
  <div data-hf-id="hf-mtqg" id="phase1" class="clip" data-start="0" data-duration="14.5" data-track-index="1" style="position:absolute;width:100%;height:100%;top:0;left:0;z-index:5;">

    <!-- Question card (full) -->
    <div data-hf-id="hf-jnl9" id="q-full-card" class="q-card" style="position:absolute;left:50%;top:80px;width:1500px;transform:translateX(-50%);">
      <div data-hf-id="hf-ptjc" class="q-text">
        The ratio between the speeds of two cars is <span data-hf-id="hf-i59i" class="num">3 : 4</span>. If the second car runs <span data-hf-id="hf-jr2l" class="num">200 km</span> in <span data-hf-id="hf-g0vo" class="num">2 hours</span>, then the speed of the first car is:
      </div>
    </div>

    <!-- Serial number badge -->
    <div data-hf-id="hf-n9mg" id="serial-num" class="serial-num" style="left:60px;top:60px;">
      <div data-hf-id="hf-nasm" class="digit">5</div>
    </div>

    <!-- Illustration area -->
    <div data-hf-id="hf-kmho" id="illustration" class="illustration" style="position:absolute;left:50%;top:480px;transform:translateX(-50%);
                width:900px;height:220px;display:flex;align-items:center;justify-content:space-between;">
      <!-- First car (blue, unknown speed) -->
      <div data-hf-id="hf-mtnb" class="car" id="car-first">
        <svg data-hf-id="hf-ou0e" viewBox="0 0 200 90"><g data-hf-id="hf-iwu3" fill="#6373db">
          <rect data-hf-id="hf-5ixm" x="20" y="35" width="160" height="30" rx="10" />
          <path data-hf-id="hf-p4kf" d="M45 35 L65 12 L135 12 L155 35 Z" />
          <circle data-hf-id="hf-msn6" cx="55" cy="68" r="16" fill="#000" />
          <circle data-hf-id="hf-55t0" cx="145" cy="68" r="16" fill="#000" />
        </g></svg>
        <div data-hf-id="hf-lm8w" class="q-label" id="car-first-q">?</div>
      </div>

      <!-- Ratio chip -->
      <div data-hf-id="hf-v0ot" class="ratio-chip" id="ratio-chip">3 : 4</div>

      <!-- Second car (red, known speed) -->
      <div data-hf-id="hf-0noj" class="car" id="car-second">
        <svg data-hf-id="hf-rhf6" viewBox="0 0 200 90"><g data-hf-id="hf-qkyl" fill="#e05c5c">
          <rect data-hf-id="hf-9uf2" x="20" y="35" width="160" height="30" rx="10" />
          <path data-hf-id="hf-ujtr" d="M45 35 L65 12 L135 12 L155 35 Z" />
          <circle data-hf-id="hf-1rl2" cx="55" cy="68" r="16" fill="#000" />
          <circle data-hf-id="hf-tpb0" cx="145" cy="68" r="16" fill="#000" />
        </g></svg>
        <div data-hf-id="hf-jifv" class="data-label" id="car-second-data">200 km · 2 hrs</div>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       PHASE 2 — Pinned question (14.5s onwards)
       ══════════════════════════════════════════════ -->
  <div data-hf-id="hf-gmkr" id="q-pinned" class="clip" data-start="14.5" data-duration="43.2" data-track-index="2" style="position:absolute;width:100%;top:0;left:50px;z-index:6;opacity:0;">
    <div data-hf-id="hf-0x9h" class="q-card pinned" style="position:absolute;left:57%;top:30px;width:1200px;transform:translateX(-50%);">
      <div data-hf-id="hf-ivvx" class="q-text">
        Ratio of speeds = <span data-hf-id="hf-52ui" class="num">3 : 4</span>. Second car: <span data-hf-id="hf-s4jl" class="num">200 km</span> in <span data-hf-id="hf-7ppg" class="num">2 hrs</span>.
      </div>
    </div>
  </div>

  <!-- Pinned illustration (smaller) -->
  <div data-hf-id="hf-9yz7" id="illus-pinned" class="clip" data-start="14.5" data-duration="43.2" data-track-index="3" style="position:absolute;left:60%;top:170px;width:520px;height:110px;transform:translateX(-50%);z-index:5;opacity:0;
              display:flex;align-items:center;justify-content:space-between;">
    <div data-hf-id="hf-g197" class="car" style="width:150px;height:70px;transform:scale(0.7);">
      <svg data-hf-id="hf-rvq7" viewBox="0 0 200 90"><g data-hf-id="hf-orcr" fill="#6373db">
        <rect data-hf-id="hf-a8q3" x="20" y="35" width="160" height="30" rx="10" />
        <path data-hf-id="hf-u5iq" d="M45 35 L65 12 L135 12 L155 35 Z" />
        <circle data-hf-id="hf-25w3" cx="55" cy="68" r="16" fill="#000" />
        <circle data-hf-id="hf-sidx" cx="145" cy="68" r="16" fill="#000" />
      </g></svg>
    </div>
    <div data-hf-id="hf-8k33" class="ratio-chip" style="opacity:1;font-size:22px;padding:6px 18px;">3 : 4</div>
    <div data-hf-id="hf-g7ff" class="car" style="width:150px;height:70px;transform:scale(0.7);">
      <svg data-hf-id="hf-sa18" viewBox="0 0 200 90"><g data-hf-id="hf-iks1" fill="#e05c5c">
        <rect data-hf-id="hf-an14" x="20" y="35" width="160" height="30" rx="10" />
        <path data-hf-id="hf-tr7p" d="M45 35 L65 12 L135 12 L155 35 Z" />
        <circle data-hf-id="hf-2k74" cx="55" cy="68" r="16" fill="#000" />
        <circle data-hf-id="hf-swoy" cx="145" cy="68" r="16" fill="#000" />
      </g></svg>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       SOLUTION CARDS (one per step, center)
       ══════════════════════════════════════════════ -->

  <!-- GIVEN -->
  <div data-hf-id="hf-ijq2" id="card-given" class="clip" data-start="14.5" data-duration="13.5" data-track-index="4" style="position:absolute;width:100%;height:100%;top:0;left:0;z-index:7;">
    <div data-hf-id="hf-a1ig" class="solution-card" style="position:absolute;left:640px;top:460px;text-align:center;">
      <span data-hf-id="hf-7r0o" class="chip">Given</span>
      <div data-hf-id="hf-c5gg" class="math">
        Speed = <span data-hf-id="hf-gq2t" class="frac"><span data-hf-id="hf-buns" class="top hi">Distance</span><span data-hf-id="hf-36mc" class="bot hi">Time</span></span><br data-hf-id="hf-x5px">
        Speed of second car = <span data-hf-id="hf-s3fd" class="frac"><span data-hf-id="hf-k8b3" class="top hi">200</span><span data-hf-id="hf-jgr9" class="bot hi">2</span></span> = <span data-hf-id="hf-or13" class="ans" id="given-ans" style="opacity:0;">100 km/hr</span>
      </div>
    </div>
  </div>

  <!-- STEP 1 -->
  <div data-hf-id="hf-7een" id="card-step1" class="clip" data-start="28" data-duration="13" data-track-index="4" style="position:absolute;width:100%;height:100%;top:0;left:0;z-index:7;">
    <div data-hf-id="hf-f272" class="solution-card" style="position:absolute;left:640px;top:440px;text-align:center;">
      <span data-hf-id="hf-3ife" class="chip">Step 1</span>
      <div data-hf-id="hf-mpzi" class="math">
        Speed of first car = <span data-hf-id="hf-jwc7" class="hi">3x</span><br data-hf-id="hf-rsrt">
        Speed of second car = <span data-hf-id="hf-zlaw" class="hi">4x</span><br data-hf-id="hf-szow">
        <span data-hf-id="hf-ixv4" class="hi">4x</span> = <span data-hf-id="hf-y6sn" class="hi">100</span> &#160; → &#160; x = <span data-hf-id="hf-o60s" class="ans" id="step1-ans" style="opacity:0;">25</span>
      </div>
    </div>
  </div>

  <!-- STEP 2 -->
  <div data-hf-id="hf-534e" id="card-step2" class="clip" data-start="41" data-duration="10" data-track-index="4" style="position:absolute;width:100%;height:100%;top:0;left:0;z-index:7;">
    <div data-hf-id="hf-vb4w" class="solution-card" style="position:absolute;left:640px;top:460px;text-align:center;">
      <span data-hf-id="hf-3wqf" class="chip">Step 2</span>
      <div data-hf-id="hf-2zhj" class="math">
        Speed of first car = <span data-hf-id="hf-rd6f" class="hi">3x</span><br data-hf-id="hf-sldv">
        = 3 × <span data-hf-id="hf-uvzp" class="hi">25</span><br data-hf-id="hf-qluq">
        = <span data-hf-id="hf-slt7" class="ans" id="step2-ans" style="opacity:0;">75 km/hr</span>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       LEFT STACK CARDS (completed steps)
       ══════════════════════════════════════════════ -->
  <div data-hf-id="hf-x3pf" id="stack-given" class="clip" data-start="28" data-duration="29.7" data-track-index="11" style="position:absolute;left:30px;top:140px;z-index:6;opacity:0;">
    <div data-hf-id="hf-usjn" class="stack-card">
      <span data-hf-id="hf-sni8" class="chip">Given</span>
      <div data-hf-id="hf-ve2p" class="math">
        Speed = Dist/Time<br data-hf-id="hf-q7jp">
        Second car = <span data-hf-id="hf-xj35" class="ans">100 km/hr</span>
      </div>
    </div>
  </div>

  <div data-hf-id="hf-f6o3" id="stack-step1" class="clip" data-start="41" data-duration="16.7" data-track-index="12" style="position:absolute;left:30px;top:300px;z-index:6;opacity:0;">
    <div data-hf-id="hf-3m9v" class="stack-card">
      <span data-hf-id="hf-qd3i" class="chip">Step 1</span>
      <div data-hf-id="hf-41ju" class="math">
        3x, 4x &#160; 4x = 100<br data-hf-id="hf-regs">
        x = <span data-hf-id="hf-4lae" class="ans">25</span>
      </div>
    </div>
  </div>

  <div data-hf-id="hf-rwu3" id="stack-step2" class="clip" data-start="49.5" data-duration="8.2" data-track-index="13" style="position:absolute;left:30px;top:460px;z-index:6;opacity:0;">
    <div data-hf-id="hf-37yu" class="stack-card">
      <span data-hf-id="hf-m16f" class="chip">Step 2</span>
      <div data-hf-id="hf-trhj" class="math">
        First car = 3 × 25<br data-hf-id="hf-r05r">
        = <span data-hf-id="hf-qu80" class="ans">75 km/hr</span>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       PHASE 3 — OPTIONS REVEAL
       ══════════════════════════════════════════════ -->
  <div data-hf-id="hf-47w5" id="options-reveal" class="clip" data-start="49.5" data-duration="8.2" data-track-index="10" style="position:absolute;width:100%;height:100%;top:0;left:0;z-index:8;opacity:0;">
    <div data-hf-id="hf-8ur8" style="position:absolute;left:480px;top:400px;width:1350px;">
      <div data-hf-id="hf-6knj" class="options-grid">
        <div data-hf-id="hf-9kry" class="opt-btn"><span data-hf-id="hf-sfug" class="letter">A</span>50 km/hr</div>
        <div data-hf-id="hf-65jl" class="opt-btn correct"><span data-hf-id="hf-r8xd" class="letter">B</span>75 km/hr</div>
        <div data-hf-id="hf-u1ug" class="opt-btn"><span data-hf-id="hf-rn8e" class="letter">C</span>100 km/hr</div>
        <div data-hf-id="hf-z58f" class="opt-btn"><span data-hf-id="hf-qgbb" class="letter">D</span>80 km/hr</div>
      </div>
    </div>
  </div>

</div><!-- end root -->

<script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
<script src="animations.js"></script>
<script>
  const tl = gsap.timeline({ paused: true });

  // PHASE 1 — Question reveal
  apt.questionEnter(tl, "#q-full-card", 0.3);
  apt.serialEnter(tl, "#serial-num", 0.8);
  apt.fadeIn(tl, "#ratio-chip", 3.7);
  apt.fadeIn(tl, "#car-second-data", 8.64);
  apt.fadeIn(tl, "#car-first-q", 12.24);
  apt.emphasize(tl, "#car-first-q", 12.6);

  // PHASE 2 — Pinned + Given
  apt.fadeOut(tl, "#phase1", 14.2);
  apt.fadeIn(tl, "#q-pinned", 14.6);
  apt.fadeIn(tl, "#illus-pinned", 14.6);
  apt.cardEnter(tl, "#card-given .solution-card", 17.3);
  apt.resultReveal(tl, "#given-ans", 24.0);
  apt.fadeOut(tl, "#illus-pinned", 48.3);
  tl.to("#q-pinned .q-card.pinned", { xPercent: -50, y: 200, scale: 1.2, duration: 0.5, ease: "power2.in" }, 49);

  // STEP 1 — morph Given card into Given stack (0.8s)
  apt.morphToStack(tl, "#card-given .solution-card", "#stack-given .stack-card", 26.6);
  tl.set("#card-step1 .solution-card", { backgroundColor:"#ffffff", boxShadow:"0 6px 24px rgba(99,115,219,0.15)", x:0, y:0, scale:1, opacity:0 }, 27.5);
  apt.cardEnter(tl, "#card-step1 .solution-card", 27.6);
  apt.resultReveal(tl, "#step1-ans", 36.74);

  // STEP 2
  apt.morphToStack(tl, "#card-step1 .solution-card", "#stack-step1 .stack-card", 39.8);
  tl.set("#card-step2 .solution-card", { backgroundColor:"#ffffff", boxShadow:"0 6px 24px rgba(99,115,219,0.15)", x:0, y:0, scale:1, opacity:0 }, 40.7);
  apt.cardEnter(tl, "#card-step2 .solution-card", 40.8);
  apt.resultReveal(tl, "#step2-ans", 45.5);

  // PHASE 3 — Options reveal
  apt.morphToStack(tl, "#card-step2 .solution-card", "#stack-step2 .stack-card", 48.3);
  apt.fadeIn(tl, "#options-reveal", 49.5);
  apt.optionsStagger(tl, ".opt-btn", 50.0);
  apt.correctPulse(tl, ".opt-btn.correct", 55.46);

  tl.set({},{},58);

  window.__timelines = window.__timelines || {};
  window.__timelines["root"] = tl;
</script>
</body>
</html>
