  "phrases": [
    {
      "start": 0.119,
      "end": 0.259,
      "text": "So"
    },
    {
      "start": 0.819,
      "end": 1.659,
      "text": "welcome back again."
    },
    {
      "start": 2.24,
      "end": 3.359,
      "text": "Time for one more problem."
    },
    {
      "start": 3.939,
      "end": 4.699,
      "text": "Now in this problem,"
    },
    {
      "start": 5.259,
      "end": 7.0,
      "text": "Alex is traveling in two parts."
    },
    {
      "start": 7.639,
      "end": 8.479,
      "text": "In the first part,"
    },
    {
      "start": 8.899,
      "end": 11.199,
      "text": "he drives at fifty kilometer"
    },
    {
      "start": 11.659,
      "end": 12.119,
      "text": "per hour"
    },
    {
      "start": 12.599,
      "end": 13.319,
      "text": "for two hours."
    },
    {
      "start": 13.859,
      "end": 14.719,
      "text": "In the second part,"
    },
    {
      "start": 15.099,
      "end": 15.899,
      "text": "because of traffic,"
    },
    {
      "start": 16.34,
      "end": 18.42,
      "text": "he drives at forty kilometer per hour"
    },
    {
      "start": 18.84,
      "end": 19.639,
      "text": "for three hours."
    },
    {
      "start": 20.1,
      "end": 24.179,
      "text": "The question is asking us to find the total distance traveled by Alex."
    },
    {
      "start": 24.699,
      "end": 26.199,
      "text": "Now we know one simple formula,"
    },
    {
      "start": 26.879,
      "end": 28.839,
      "text": "distance equal to speed into time."
    },
    {
      "start": 29.439,
      "end": 29.979,
      "text": "So first,"
    },
    {
      "start": 30.34,
      "end": 32.179,
      "text": "let us find the distance in the first part."
    },
    {
      "start": 32.719,
      "end": 36.179,
      "text": "In first part, speed is fifty and time is two hours."
    },
    {
      "start": 36.599,
      "end": 38.599,
      "text": "So distance will be fifty into two,"
    },
    {
      "start": 39.139,
      "end": 40.159,
      "text": "which is one hundred"
    },
    {
      "start": 40.479,
      "end": 41.259,
      "text": "kilometer."
    },
    {
      "start": 41.84,
      "end": 42.219,
      "text": "Next,"
    },
    {
      "start": 42.559,
      "end": 44.36,
      "text": "find the distance in the second part."
    },
    {
      "start": 44.899,
      "end": 47.659,
      "text": "Now in second part, speed is forty and time is three hours."
    },
    {
      "start": 48.239,
      "end": 49.919,
      "text": "So distance will be forty into three,"
    },
    {
      "start": 50.36,
      "end": 52.319,
      "text": "which is one hundred twenty kilometer."
    },
    {
      "start": 53.099,
      "end": 54.459,
      "text": "Now we have both distances."
    },
    {
      "start": 54.959,
      "end": 60.879,
      "text": "In first part it is one hundred kilometer, and in second part it's one hundred twenty kilometer."
    },
    {
      "start": 62.039,
      "end": 64.18,
      "text": "Since the question asks for total distance,"
    },
    {
      "start": 64.779,
      "end": 65.739,
      "text": "we need to add both,"
    },
    {
      "start": 66.639,
      "end": 68.72,
      "text": "one hundred plus one hundred twenty"
    },
    {
      "start": 69.58,
      "end": 74.179,
      "text": "equals two hundred twenty kilometers. So the final answer will be two hundred twenty kilometers."
    },
    {
      "start": 74.76,
      "end": 77.0,
      "text": "So the correct answer is option C."
    }
