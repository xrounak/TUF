<style>
  /* ── Per-question illustration pieces (flat 2D, inline — no extra assets needed) ── */
  .van-wrap { position: relative; display: flex; flex-direction: column; align-items: center; }
  .van-road { width: 210px; height: 4px; background: #d4d4d4; margin: -6px 0 10px; }
  .van-label {
    font-family: var(--font); font-weight: 400; font-size: 28px; color: var(--primary);
    margin-bottom: 8px; text-align: center; white-space: nowrap;
  }
  .van-icon { width: 210px; height: auto; display: block; }

  /* Stop badge — small circle, primary fill, white "STOP" text (no new
     colors introduced — reuses --primary rather than inventing a red). */
  .stop-badge {
    width: 56px; height: 56px; border-radius: 50%;
    background: var(--primary); display: flex; align-items: center; justify-content: center;
    font-family: var(--font); font-weight: 400; font-size: 14px; color: #FFFFFF; text-align: center;
  }

  /* Clock icon — flat 2D, CSS only (circle + two hands) */
  .clock-face {
    width: 56px; height: 56px; border-radius: 50%;
    border: 4px solid #000000; background: #FFFFFF; position: relative;
  }
  .clock-face .hand-hr { position: absolute; left: 50%; top: 50%; width: 3px; height: 14px; background: #000000; transform-origin: bottom center; transform: translate(-50%, -100%) rotate(45deg); }
  .clock-face .hand-min { position: absolute; left: 50%; top: 50%; width: 3px; height: 18px; background: #000000; transform-origin: bottom center; transform: translate(-50%, -100%) rotate(150deg); }
  .clock-label { font-family: var(--font); font-weight: 400; font-size: 22px; color: var(--topic); text-align: center; margin-top: 8px; }
  .clock-label .num { color: var(--primary); }

  /* .chip in design-system.css is scoped to .solution-card/.stack-card, so
     inside .van-wrap it renders as plain unstyled text — give it the same
     pill look explicitly here (matches convention from other builds). */
  .van-wrap .chip {
    display: inline-block;
    background: var(--primary);
    color: #FFFFFF;
    padding: 5px 16px;
    border-radius: var(--radius-pill);
    font-family: var(--font);
    font-weight: 400;
    font-size: 16px;
    margin-bottom: 10px;
  }
  .solution-card .math { font-size: 36px; }
</style>
</head>
