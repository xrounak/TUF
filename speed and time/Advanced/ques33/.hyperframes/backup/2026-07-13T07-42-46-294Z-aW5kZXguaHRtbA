<script>
  const tl = gsap.timeline({ paused: true });

  // PHASE 1 — Question reveal
  const HERO_OFFSET_Y = 180;
  const RISE_TIME = 3.8;
  apt.heroEnterLowered(tl, "#q-full-card", HERO_OFFSET_Y, RISE_TIME);

  tl.fromTo("#serial-num",
    { scale: 0, rotation: -45, opacity: 0, y: HERO_OFFSET_Y },
    { scale: 1, rotation: 0, opacity: 1, y: HERO_OFFSET_Y, duration: 0.55, ease: "back.out(2)" },
    0.8);
  tl.to("#serial-num", { y: 0, duration: 0.6, ease: "power2.inOut" }, RISE_TIME);

  // Illustration build — van (no-stops speed), then stop-badge (with-stops
  // average speed), then clock (total journey time)
  apt.fadeIn(tl, "#van-wrap", 6.02);
  apt.fadeIn(tl, "#van-label", 8.86);
  apt.fadeIn(tl, "#stop-wrap", 12.46);
  apt.fadeIn(tl, "#avg-label", 13.02);
  apt.fadeIn(tl, "#clock-wrap", 18.6);

  // PHASE 2 — Pin, then Given
  const PIN_TIME = 22.9;
  const GIVEN_TIME = 23.7; // own transcript-derived timestamp — right after pin completes

  apt.pinFlow(tl, "#q-full-card", "#q-pinned", PIN_TIME);
  apt.pinFlow(tl, "#illustration", "#illus-pinned", PIN_TIME);
  apt.fadeOut(tl, "#serial-num", PIN_TIME, 0.5);

  apt.cardEnter(tl, "#card-given .solution-card", GIVEN_TIME);
  apt.textReveal(tl, "#card-given .math");

  // STEP 1 — morph Given card into Given stack (0.8s).
  apt.morphToStack(tl, "#card-given .solution-card", "#stack-given .stack-card", 25.1);
  apt.cardEnter(tl, "#card-step1 .solution-card", 25.9);
  apt.textReveal(tl, "#card-step1 .math");

  // STEP 2 — Step 1 joins the stack: grow the G→1 connector line.
  apt.morphToStack(tl, "#card-step1 .solution-card", "#stack-step1 .stack-card", 43.78);
  apt.stackLineGrow(tl, "#line-g-1", 43.78);
  apt.cardEnter(tl, "#card-step2 .solution-card", 44.58);
  apt.textReveal(tl, "#card-step2 .math");

  // STEP 3 — Step 2 joins the stack: grow the 1→2 connector line.
  apt.morphToStack(tl, "#card-step2 .solution-card", "#stack-step2 .stack-card", 61.32);
  apt.stackLineGrow(tl, "#line-1-2", 61.32);
  apt.cardEnter(tl, "#card-step3 .solution-card", 62.12);
  apt.textReveal(tl, "#card-step3 .math");

  // ── Recenter — clear the stack column before options reveal.
  const RECENTER_TIME = 74.76;
  apt.fadeOut(tl, "#illus-pinned", RECENTER_TIME);
  apt.recenterForOptions(tl, "#q-pinned", 160, 180, RECENTER_TIME);

  // PHASE 3 — Options reveal — Step 3 joins the stack: grow the 2→3 line.
  apt.morphToStack(tl, "#card-step3 .solution-card", "#stack-step3 .stack-card", 74.76);
  apt.stackLineGrow(tl, "#line-2-3", 74.76);
