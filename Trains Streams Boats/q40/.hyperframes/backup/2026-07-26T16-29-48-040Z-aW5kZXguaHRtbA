<meta charset="UTF-8">
<link rel="stylesheet" href="design-system.css">
<style>
  /* ═══════════════════════════════════════════════════════════════
     PER-QUESTION ILLUSTRATION — Two trains on a rail, opposite edges,
     Train A carries the passenger (collapses to a "point"), Train B
     is the 180 m train whose length is the only relevant distance.
     Two floating equation tags (relative speed, unit conversion) build
     word-by-word via apt.textReveal, reusing .tag-pill + .frac only.
     Colors reuse existing tokens only.
     ═══════════════════════════════════════════════════════════════ */

  #illustration {
    position: absolute;
    left: 50%;
    top: 430px;
    transform: translateX(-50%);
    width: 1400px;
    height: 320px;
  }

  #rail {
    position: absolute; left: 0; top: 150px; width: 1400px; height: 16px;
    background: repeating-linear-gradient(90deg, #b7bcc9 0 10px, transparent 10px 34px);
    border-top: 4px solid #8b93a6; border-bottom: 4px solid #8b93a6; border-radius: 2px;
    opacity: 0; transform: scaleX(0); transform-origin: left center;
  }

  #train-a-unit {
    position: absolute; left: 20px; top: 10px; width: 190px; height: 170px;
    opacity: 0; transform: translateY(40px) scale(0.92);
  }
  #train-a-unit img { width: 100%; height: 100%; display: block; }
  #speed-badge-a {
    position: absolute; left: 50%; top: -0px; width: 150px; height: 40px; transform: translateX(-50%);
    display: flex; align-items: center; justify-content: center;
    background: var(--primary); color: #FFFFFF; border-radius: var(--radius-pill);
    font-family: var(--font); font-weight: 400; font-size: 20px; white-space: nowrap; opacity: 0;
  }

  #passenger-dot {
    position: absolute; left: 118px; top: -34px; width: 40px; height: 40px;
    border-radius: 50%; background: #FFFFFF; border: 3px solid var(--primary);
    display: flex; align-items: center; justify-content: center;
    opacity: 0; transform: scale(0.6); transform-origin: center;
  }
  #passenger-dot .glyph {
    width: 12px; height: 12px; border-radius: 50%; background: var(--primary);
    position: relative;
  }
  #passenger-dot .glyph::after {
    content: ""; position: absolute; top: 14px; left: -6px; width: 24px; height: 14px;
    border-radius: 10px 10px 0 0; background: var(--primary);
  }

  #train-b-outer {
    position: absolute; right: 20px; top: 10px; width: 190px; height: 170px;
    opacity: 0; transform: translateY(40px) scale(0.92);
  }
  #train-b-img-wrap { width: 100%; height: 100%; transform: scaleX(-1); }
  #train-b-img-wrap img { width: 100%; height: 100%; display: block; }
  #speed-badge-b {
    position: absolute; left: 50%; top: -0px; width: 150px; height: 40px; transform: translateX(-50%);
    display: flex; align-items: center; justify-content: center;
    background: var(--primary); color: #FFFFFF; border-radius: var(--radius-pill);
    font-family: var(--font); font-weight: 400; font-size: 20px; white-space: nowrap; opacity: 0;
  }
  #length-badge-b {
    position: absolute; left: 50%; top: -66px; width: 150px; height: 40px; transform: translateX(-50%);
    display: flex; align-items: center; justify-content: center;
    background: var(--primary-light); color: var(--primary); border-radius: var(--radius-pill);
    font-family: var(--font); font-weight: 400; font-size: 20px; white-space: nowrap; opacity: 0;
  }

  #opp-arrows {
    position: absolute; left: 700px; top: 62px; transform: translateX(-50%);
    width: 260px; display: flex; align-items: center; justify-content: space-between;
    opacity: 0; transform: translateY(40px) scale(0.92);
  }
  .chevron-right { width: 0; height: 0; border-top: 11px solid transparent; border-bottom: 11px solid transparent; border-left: 18px solid var(--primary); }
  .chevron-left  { width: 0; height: 0; border-top: 11px solid transparent; border-bottom: 11px solid transparent; border-right: 18px solid var(--primary); }

  .tag-pill {
    position: absolute; left: 50%; transform: translateX(-50%);
    white-space: nowrap; padding: 8px 22px; border-radius: var(--radius-pill);
    background: var(--primary-light); color: var(--primary);
    font-family: var(--font); font-weight: 400; font-size: 22px; opacity: 0;
    display: flex; align-items: center; gap: 8px;
  }
  #point-tag { top: -132px; font-size: 20px; }

  #relspeed-tag { top: 220px; font-size: 24px; }
  #unitconv-tag { top: 268px; font-size: 24px; }
  .tag-pill .rv { opacity: 0; }
  .tag-pill .frac { transform: scale(0.62); }

  /* Pinned (Phase 2+) recap — two mini trains, space-between */
  .pinned-illus-content {
    display: flex; align-items: center; justify-content: space-between;
    width: 100%; height: 100%; padding: 0 20px;
  }
  .pinned-train-wrap { display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .pinned-train-wrap img { width: 78px; height: 78px; display: block; }
  #pinned-train-b-img { transform: scaleX(-1); }
  .pinned-illus-label { font-family: var(--font); font-weight: 400; font-size: 23px; color: var(--text); }
  .pinned-illus-label .num { color: var(--primary); }
</style>
