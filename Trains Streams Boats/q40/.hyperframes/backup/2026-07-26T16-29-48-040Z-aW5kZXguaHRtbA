<script>
  // Space the stack column with a real, measured gap.
  (function layoutStack() {
    const ids = ["stack-given", "stack-step1", "stack-step2"];
    const root = document.querySelector("#root");
    const rootBox = root.getBoundingClientRect();
    const pxScale = 1920 / rootBox.width;
    const gap = 40;
    let top = 140;
    ids.forEach(function (id) {
      const wrapper = document.getElementById(id);
      if (!wrapper) return;
      wrapper.style.top = top + "px";
      const card = wrapper.querySelector(".stack-card");
      const h = card ? card.getBoundingClientRect().height * pxScale : 120;
      top += h + gap;
    });
  })();

  apt.setStackLine("#line-g-1", "#stack-given .step-circle", "#stack-step1 .step-circle");
  apt.setStackLine("#line-1-2", "#stack-step1 .step-circle", "#stack-step2 .step-circle");

  gsap.set("#passenger-dot", {
    rotationX: 3,
    rotationY: 2,
    z: 0,
    transformPerspective: 1080
  });

  gsap.set("#passenger-dot", {
    x: 50,
    y: 550
  });

  const tl = gsap.timeline({ paused: true });

  // ── PHASE 1 — Question hero entrance
  const HERO_OFFSET_Y = 180;
  const RISE_TIME = 3.76; // end of "It's time to solve one more problem."
  apt.heroEnterLowered(tl, "#q-full-card", HERO_OFFSET_Y, RISE_TIME);

  tl.fromTo("#serial-num",
    { scale: 0, rotation: -45, opacity: 0, y: HERO_OFFSET_Y },
    { scale: 1, rotation: 0, opacity: 1, duration: 0.55, ease: "back.out(2)", y: HERO_OFFSET_Y },
    0.8);
  tl.to("#serial-num", { y: 0, duration: 0.6, ease: "power2.inOut" }, RISE_TIME);

  // ── Rail + Train A + passenger, then Train B + its givens
  apt.roadSweep(tl, "#rail", 4.0);
  apt.cardEnter(tl, "#train-a-unit", 5.62);   // "passenger"
  apt.cardEnter(tl, "#passenger-dot", 5.62);
  apt.cardEnter(tl, "#speed-badge-a", 8.76);  // "thirty-six"

  apt.cardEnter(tl, "#train-b-outer", 11.80);   // "another"
  apt.cardEnter(tl, "#length-badge-b", 13.20);  // "one" (hundred eighty)
  apt.cardEnter(tl, "#opp-arrows", 14.98);      // "opposite"
  apt.cardEnter(tl, "#speed-badge-b", 16.08);   // "fifty-four"

  // ── THE key concept: passenger collapses to a point
  tl.to("#passenger-dot", { scale: 0.55, duration: 0.5, ease: "power2.inOut" }, 24.88); // "that"
  apt.cardEnter(tl, "#point-tag", 25.18); // "passenger" (is treated as a point)
  apt.emphasize(tl, "#length-badge-b", 32.50); // "one" (hundred eighty meter) — re-anchor 180 m

  // ── Confirmatory drift: trains close distance while "opposite -> add" is spoken
  tl.to("#train-a-unit", { x: 90, duration: 10.62, ease: "none" }, 34.50);
  tl.to("#train-b-outer", { x: -90, duration: 10.62, ease: "none" }, 34.50);

  // ── Relative speed equation builds
  apt.cardEnter(tl, "#relspeed-tag", 39.78);
  apt.textReveal(tl, "#relspeed-tag");

  // ── Unit conversion equation builds
  apt.cardEnter(tl, "#unitconv-tag", 46.04);
  apt.textReveal(tl, "#unitconv-tag");
  apt.emphasize(tl, "#unitconv-tag .ans", 53.56); // "Done."

  // ── PHASE 2 — Pin flow
  const PIN_TIME = 54.56;
  apt.pinFlow(tl, "#q-full-card", "#q-pinned", PIN_TIME);
  apt.pinFlow(tl, "#illustration", "#illus-pinned", PIN_TIME);
  apt.fadeOut(tl, "#serial-num", PIN_TIME, 0.5);

  const RECENTER_TIME = 76.24;
  apt.ambientLoop(tl, "#illus-pinned-icon-a", PIN_TIME + 1, RECENTER_TIME, { period: 1.4, amp: 6 });
  apt.ambientLoop(tl, "#illus-pinned-icon-b", PIN_TIME + 1, RECENTER_TIME, { period: 1.4, amp: 6 });

  const GIVEN_TIME = 56.50; // fresh statement, not a recap
  apt.cardEnter(tl, "#card-given .solution-card", GIVEN_TIME);
  apt.textReveal(tl, "#card-given .math");

  // ── STEP 1 — formula
  const GIVEN_MORPH_TIME = 64.40;
  apt.morphToStack(tl, "#card-given .solution-card", "#stack-given .stack-card", GIVEN_MORPH_TIME);
  apt.cardEnter(tl, "#card-step1 .solution-card", 65.20);
  apt.textReveal(tl, "#card-step1 .math");

  // ── STEP 2 — substitute + resolve
  const STEP1_MORPH_TIME = 68.64;
  apt.morphToStack(tl, "#card-step1 .solution-card", "#stack-step1 .stack-card", STEP1_MORPH_TIME);
  apt.stackLineGrow(tl, "#line-g-1", STEP1_MORPH_TIME);
  apt.cardEnter(tl, "#card-step2 .solution-card", 69.44);
  apt.textReveal(tl, "#card-step2 .math");

  // ── Recenter + clear illustration recap before options.
  apt.fadeOut(tl, "#illus-pinned", RECENTER_TIME);
  apt.recenterForOptions(tl, "#q-pinned", 160, 180, RECENTER_TIME);

  // ── PHASE 3 — Options reveal
  apt.morphToStack(tl, "#card-step2 .solution-card", "#stack-step2 .stack-card", RECENTER_TIME);
  apt.stackLineGrow(tl, "#line-1-2", RECENTER_TIME);
  apt.fadeIn(tl, "#options-reveal", 77.20);
  apt.optionsStagger(tl, ".opt-btn", 77.60);
  apt.correctPulse(tl, ".opt-btn.correct", 84.16);

  // ── END FADE
  const END_FADE_TIME = 85.70;
  apt.fadeOut(tl, "#root > div", END_FADE_TIME, 1.0);

  tl.set({}, {}, 87);

  window.__timelines = window.__timelines || {};
  window.__timelines["root"] = tl;
</script>
</body>
</html>
