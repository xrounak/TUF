<script>
  // Space the stack column with a real, measured gap instead of a
  // hand-guessed top value (Given is 2 lines, Step 1 is 1 line).
  (function layoutStack() {
    const ids = ["stack-given", "stack-step1"];
    const root = document.querySelector("#root");
    const rootBox = root.getBoundingClientRect();
    const pxScale = 1920 / rootBox.width;
    const gap = 40;
    let top = 140;
    ids.forEach(function (id) {
      const wrapper = document.getElementById(id);
      if (!wrapper) return;
      wrapper.style.top = top + "px";
      const card = wrapper.querySelector(".stack-card");
      const h = card ? card.getBoundingClientRect().height * pxScale : 120;
      top += h + gap;
    });
  })();

  apt.setStackLine("#line-g-1", "#stack-given .step-circle", "#stack-step1 .step-circle");

  const tl = gsap.timeline({ paused: true });

  // ── Local helper: seamless "conveyor" wave-chain scroll (same technique
  // as speed-time-and-distance/q8). Two identical tile-copies back to back
  // means x:0 and x:-tileWidth look the same, so a bounded (never -1)
  // repeat count restarts cleanly each cycle.
  function riverFlow(tl, selector, tileWidth, startTime, endTime, period) {
    const reps = Math.max(1, Math.ceil((endTime - startTime) / period));
    tl.fromTo(selector, { x: -tileWidth }, { x: 0, duration: period, ease: "none", repeat: reps }, startTime);
  }

  // ── Local helper: bounded wake-line flicker behind the boat.
  function wakeFlicker(tl, start, end) {
    const period = 0.4, half = period / 2;
    const reps = Math.max(1, Math.floor((end - start) / half) - 1);
    ["#wake-1", "#wake-2", "#wake-3"].forEach(function (sel, i) {
      tl.fromTo(sel, { opacity: 0 }, { opacity: 0.85, duration: half, ease: "sine.inOut", yoyo: true, repeat: reps }, start + i * 0.08);
    });
  }

  // ── PHASE 1 — Question hero entrance
  const HERO_OFFSET_Y = 180;
  const RISE_TIME = 4.3;
  apt.heroEnterLowered(tl, "#q-full-card", HERO_OFFSET_Y, RISE_TIME);

  tl.fromTo("#serial-num",
    { scale: 0, rotation: -45, opacity: 0, y: HERO_OFFSET_Y },
    { scale: 1, rotation: 0, opacity: 1, duration: 0.55, ease: "back.out(2)", y: HERO_OFFSET_Y },
    0.8);
  tl.to("#serial-num", { y: 0, duration: 0.6, ease: "power2.inOut" }, RISE_TIME);

  // ── River + boat scene assembles as the given speeds are narrated
  apt.cardEnter(tl, "#river-scene", 4.86);
  apt.cardEnter(tl, "#boat-unit", 5.4);
  riverFlow(tl, "#river-track-front", 125, 4.86, 58.3, 2.0);
  riverFlow(tl, "#river-track-back", 150, 4.86, 58.3, 3.4);
  apt.ambientLoop(tl, "#boat-icon", 5.4, 58.3, { period: 1.6, amp: 5 });

  apt.cardEnter(tl, "#boat-badge", 10.18);
  apt.cardEnter(tl, "#stream-badge", 15.08);
  apt.cardEnter(tl, "#flow-arrows", 15.08);

  // ── Given card — enters early (8s), in the same Phase-1 frame as the
  // question/illustration, and stays until it morphs to the stack right
  // before Step 2. textReveal syncs each value to its real spoken word.
  apt.cardEnter(tl, "#card-given .solution-card", 8);
  apt.textReveal(tl, "#card-given .math");

  // ── Flow direction fixed
  apt.emphasize(tl, "#flow-arrows", 25.08);

  // ── DOWNSTREAM: speeds add (28.34 → 44.46) — synced to real narration
  tl.to("#boat-unit", { x: 950, duration: 16.12, ease: "power1.out" }, 28.34);
  wakeFlicker(tl, 28.34, 44.46);
  tl.fromTo("#merge-chip", { opacity: 0, x: -130 }, { opacity: 1, x: 0, duration: 0.6, ease: "power2.out" }, 32.56);
  tl.to("#merge-chip", { opacity: 0, duration: 0.3 }, 34.9);
  tl.to("#bb-solo", { opacity: 0, duration: 0.25 }, 35.22);
  tl.to("#bb-sum", { opacity: 1, duration: 0.25 }, 35.22);
  apt.cardEnter(tl, "#formula-tag", 39.30);
  apt.emphasize(tl, "#formula-tag", 43.56);

  // ── PHASE 2 — Pin flow (48.3s). The Given card is untouched by the pin
  // (it lives independently of #phase1/#illustration) and keeps reading
  // through the transition.
  const PIN_TIME = 48.3;
  apt.pinFlow(tl, "#q-full-card", "#q-pinned", PIN_TIME);
  apt.pinFlow(tl, "#illustration", "#illus-pinned", PIN_TIME);
  apt.fadeOut(tl, "#serial-num", PIN_TIME, 0.5);

  // Mini river/boat recap keeps animating continuously through the ENTIRE
  // Given/Step2 phase.
  const RECENTER_TIME = 58.3;
  riverFlow(tl, "#river-track-mini-front", 52, PIN_TIME + 1, RECENTER_TIME, 1.1);
  riverFlow(tl, "#river-track-mini-back", 65, PIN_TIME + 1, RECENTER_TIME, 1.8);
  apt.ambientLoop(tl, "#illus-pinned-icon", PIN_TIME + 1, RECENTER_TIME, { period: 1.4, amp: 6 });

  // ── STEP 2 — Given morphs into the stack, Step 2 opens with the addition
  // at the 50th second.
  const STEP2_MORPH_TIME = 49.2;
  apt.morphToStack(tl, "#card-given .solution-card", "#stack-given .stack-card", STEP2_MORPH_TIME);
  apt.cardEnter(tl, "#card-step1 .solution-card", 50.0);
  apt.textReveal(tl, "#card-step1 .math");

  // ── Recenter + clear illustration recap before options — the ONE
  // deliberate stop in the whole video, immediately superseded by the
  // options-reveal's own stagger/pulse motion.
  apt.fadeOut(tl, "#illus-pinned", RECENTER_TIME);
  apt.recenterForOptions(tl, "#q-pinned", 160, 180, RECENTER_TIME);

  // ── PHASE 3 — Options reveal
  apt.morphToStack(tl, "#card-step1 .solution-card", "#stack-step1 .stack-card", RECENTER_TIME);
  apt.stackLineGrow(tl, "#line-g-1", RECENTER_TIME);
  apt.fadeIn(tl, "#options-reveal", 58.9);
  apt.optionsStagger(tl, ".opt-btn", 59.3);
  apt.correctPulse(tl, ".opt-btn.correct", 65.72);

  // ── END FADE
  const END_FADE_TIME = 66.9;
  apt.fadeOut(tl, "#root > div", END_FADE_TIME, 1.2);

  tl.set({}, {}, 69);

  window.__timelines = window.__timelines || {};
  window.__timelines["root"] = tl;
</script>
