<style>
  /* ═══════════════════════════════════════════════════════════════
     PER-QUESTION ILLUSTRATION — Flowing river + boat (custom, per
     design.md "Illustration" section). Simplified variant of the
     speed-time-and-distance/q8 river+boat technique: single direction
     (downstream only, no upstream leg), badges show REAL numbers (12,
     3) instead of algebra letters, since both operands are already
     known and this is a direct addition, not simultaneous equations.
     Colors reuse existing tokens only: --primary (waves front layer,
     badges), --primary-light (water body, waves back layer, chip).
     ═══════════════════════════════════════════════════════════════ */

  #illustration {
    position: absolute;
    left: 50%;
    top: 470px;
    transform: translateX(-50%);
    width: 1500px;
    height: 280px;
  }

  #river-scene {
    position: absolute; left: 0; top: 140px; width: 1500px; height: 90px;
    border-radius: 16px;
    overflow: hidden;
    opacity: 0;
    transform: translateY(40px) scale(0.92);
  }
  #water-fill { position: absolute; inset: 0; background: var(--primary-light); }

  #river-track-back, #river-track-front {
    position: absolute; left: 0; display: flex;
  }
  #river-track-back  { top: 8px;  width: 3000px; height: 74px; }
  #river-track-front { top: 22px; width: 3000px; height: 60px; }
  .wave-tile-back  { width: 150px; height: 70px; flex: none; }
  .wave-tile-front { width: 125px; height: 56px; flex: none; }

  #boat-unit {
    position: absolute; left: 150px; top: 95px; width: 130px; height: 130px;
    opacity: 0;
    transform: translateY(40px) scale(0.92);
  }
  #boat-icon { width: 100%; height: 100%; display: block; }

  .badge-pill {
    position: absolute;
    display: flex; align-items: center; justify-content: center;
    background: var(--primary);
    color: #FFFFFF;
    border-radius: var(--radius-pill);
    font-family: var(--font);
    font-weight: 400;
    font-size: 20px;
    white-space: nowrap;
  }
  #boat-badge { left: 50%; top: -46px; width: 118px; height: 40px; transform: translateX(-50%); }
  .b-state { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
  #bb-solo { opacity: 1; }
  #bb-sum  { opacity: 0; }

  #stream-badge {
    left: 700px; top: 76px; width: 74px; height: 40px;
    opacity: 0; transform: translateY(40px) scale(0.92);
  }

  .chip-pill {
    position: absolute;
    display: flex; align-items: center; justify-content: center;
    background: var(--primary-light);
    border: 2px solid var(--primary);
    color: var(--primary);
    border-radius: var(--radius-pill);
    font-family: var(--font);
    font-weight: 400;
    font-size: 16px;
    white-space: nowrap;
    opacity: 0;
  }
  #merge-chip { left: 30px; top: -46px; width: 62px; height: 32px; }

  .wake-line {
    position: absolute; top: 62px; width: 22px; height: 4px;
    background: var(--primary-light); border-radius: 2px; opacity: 0;
  }
  #wake-1 { left: -18px; }
  #wake-2 { left: -34px; }
  #wake-3 { left: -50px; }

  #flow-arrows {
    position: absolute; left: 1060px; top: 158px; width: 150px; height: 22px;
    display: flex; align-items: center; gap: 16px;
    opacity: 0; transform: translateY(40px) scale(0.92);
  }
  .chevron {
    width: 0; height: 0;
    border-top: 9px solid transparent;
    border-bottom: 9px solid transparent;
    border-left: 15px solid var(--primary);
  }

  .formula-tag {
    position: absolute; left: 50%; top: -40px; transform: translateX(-50%);
    white-space: nowrap;
    padding: 8px 22px;
    border-radius: var(--radius-pill);
    background: var(--primary-light);
    color: var(--primary);
    font-family: var(--font);
    font-weight: 400;
    font-size: 22px;
    opacity: 0;
  }

  /* Pinned (Phase 2+) recap — a MINIATURE river+boat that keeps
     animating continuously through Given/Step1, per the brief: never
     let the pinned area go static while the solution is being written. */
  .pinned-illus-content {
    display: flex; align-items: center; justify-content: center;
    gap: 26px; width: 100%; height: 100%;
  }
  #pinned-river-wrap {
    width: 280px; height: 52px; border-radius: 10px; overflow: hidden;
    position: relative;
  }
  #pinned-water-fill { position: absolute; inset: 0; background: var(--primary-light); }
  #river-track-mini-back, #river-track-mini-front { position: absolute; left: 0; display: flex; }
  #river-track-mini-back  { top: 4px;  width: 1040px; height: 44px; }
  #river-track-mini-front { top: 12px; width: 1040px; height: 34px; }
  .wave-tile-mini-back  { width: 65px; height: 40px; flex: none; }
  .wave-tile-mini-front { width: 52px; height: 30px; flex: none; }
  #illus-pinned-icon { width: 72px; height: 72px; }
  .pinned-illus-label {
    font-family: var(--font);
    font-weight: 400;
    font-size: 23px;
    color: var(--text);
  }
  .pinned-illus-label .num { color: var(--primary); }
