      #wake-1 { left: -18px; }
      #wake-2 { left: -34px; }
      #wake-3 { left: -50px; }

      .formula-tag {
        position: absolute;
        left: 50%;
        top: -40px;
        transform: translateX(-50%);
        white-space: nowrap;
        padding: 8px 22px;
        border-radius: var(--radius-pill);
        background: var(--primary-light);
        color: var(--primary);
        font-family: var(--font);
        font-weight: 400;
        font-size: 22px;
        opacity: 0;
      }

      /* Variable-definition chips (D/U/C/B) - q8 chip-pill pattern, appear
         one at a time as each variable is narrated and persist. */
      #var-legend {
        position: absolute;
        left: 50%;
        top: -110px;
        transform: translateX(-50%);
        display: flex;
        gap: 14px;
      }
      .chip-pill {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--primary-light);
        border: 2px solid var(--primary);
        color: var(--primary);
        border-radius: var(--radius-pill);
        font-family: var(--font);
        font-weight: 400;
        font-size: 18px;
        white-space: nowrap;
        padding: 8px 18px;
        opacity: 0;
      }

      /* Early given-fact floater - relation stated up front, stays on
         screen through Phase 1. */
      .given-mini {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        white-space: nowrap;
        padding: 10px 26px;
        border-radius: 12px;
        background: #ffffff;
        border: 2px solid var(--primary);
        font-family: var(--font);
        font-weight: 400;
        font-size: 24px;
