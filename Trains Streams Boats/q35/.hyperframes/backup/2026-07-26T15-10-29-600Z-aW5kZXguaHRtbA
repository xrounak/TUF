      #boat-icon {
        width: 100%;
        height: 100%;
        display: block;
      }

      .badge-pill {
        position: absolute;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--primary);
        color: #ffffff;
        border-radius: var(--radius-pill);
        font-family: var(--font);
        font-weight: 400;
        font-size: 20px;
        white-space: nowrap;
      }
      #b-badge {
        left: 50%;
        top: -46px;
        width: 120px;
        height: 40px;
        transform: translateX(-50%);
