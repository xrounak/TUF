    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <script src="animations.js"></script>
    <script>
      /* Space the stack column with a real, measured gap instead of
         hand-guessed top values. */
      (function layoutStack() {
        const ids = ["stack-given", "stack-step1", "stack-step2", "stack-step3"];
        const root = document.querySelector("#root");
        const rootBox = root.getBoundingClientRect();
        const pxScale = 1920 / rootBox.width;
        const gap = 40;
        let top = 140;
        ids.forEach(function (id) {
          const wrapper = document.getElementById(id);
          if (!wrapper) return;
          wrapper.style.top = top + "px";
          const card = wrapper.querySelector(".stack-card");
          const h = card ? card.getBoundingClientRect().height * pxScale : 120;
          top += h + gap;
        });
      })();

      apt.setStackLine("#line-g-1", "#stack-given .step-circle", "#stack-step1 .step-circle");
      apt.setStackLine("#line-1-2", "#stack-step1 .step-circle", "#stack-step2 .step-circle");
      apt.setStackLine("#line-2-3", "#stack-step2 .step-circle", "#stack-step3 .step-circle");

      const tl = gsap.timeline({ paused: true });

      tl.set("#card-given .solution-card", { x: 15, y: 13, data: "hf-hold" }, 0);

      // ── Local helper: seamless "conveyor" wave-chain scroll.
      function riverFlow(tl, selector, tileWidth, startTime, endTime, period) {
        const reps = Math.max(1, Math.ceil((endTime - startTime) / period));
        tl.fromTo(selector, { x: -tileWidth }, { x: 0, duration: period, ease: "none", repeat: reps }, startTime);
      }

      // ── Local helper: bounded wake-line flicker behind the boat.
      function wakeFlicker(tl, start, end) {
        const ids = ["#wake-1", "#wake-2", "#wake-3"];
        const period = 0.4, half = period / 2;
        const reps = Math.max(1, Math.floor((end - start) / half) - 1);
        ids.forEach(function (sel, i) {
          tl.fromTo(sel, { opacity: 0 }, { opacity: 0.85, duration: half, ease: "sine.inOut", yoyo: true, repeat: reps }, start + i * 0.08);
        });
        tl.set(ids, { opacity: 0 }, end);
      }

      // ── Local helper: bounded rocking judder - current resists the boat
      // during the upstream leg (rotation only, composes with x-travel).
      function boatJudder(tl, start, end, amp) {
        const period = 0.7, half = period / 2;
        const reps = Math.max(1, Math.floor((end - start) / half) - 1);
        const a = amp || 2.5;
        tl.fromTo("#boat-unit", { rotation: -a }, { rotation: a, duration: half, ease: "sine.inOut", yoyo: true, repeat: reps }, start);
      }

      // ── PHASE 1 - Question hero entrance
      const HERO_OFFSET_Y = 180;
      const RISE_TIME = 4.10; // end of "it's time to solve one more problem"
      apt.heroEnterLowered(tl, "#q-full-card", HERO_OFFSET_Y, RISE_TIME);

      tl.fromTo("#serial-num",
        { scale: 0, rotation: -45, opacity: 0, y: HERO_OFFSET_Y },
        { scale: 1, rotation: 0, opacity: 1, duration: 0.55, ease: "back.out(2)", y: HERO_OFFSET_Y },
        0.8);
      tl.to("#serial-num", { y: 0, duration: 0.6, ease: "power2.inOut" }, RISE_TIME);

      const PIN_TIME = 58.5;
      const GIVEN_TIME = 18.64;
      const RECENTER_TIME = 122.0;

      // ── River + boat scene builds as the question is read out.
      apt.cardEnter(tl, "#river-scene", 4.72);
      apt.cardEnter(tl, "#boat-unit", 4.72);
      riverFlow(tl, "#river-track-front", 125, 4.72, PIN_TIME, 2.0);
      riverFlow(tl, "#river-track-back", 150, 4.72, PIN_TIME, 3.4);

      // ── Given-fact floaters - plain restatement, appear as each value is
      // actually narrated, stay maintained on screen (not faded).
      apt.cardEnter(tl, "#given-relation", 4.72);    // "downstream speed is twenty-five percentage more"
      apt.cardEnter(tl, "#given-stillwater", 10.84);  // "still-water speed is eighteen kilometers per hour"

      // ── Variable chips (D/U/C/B) - pop in as each is narrated, persist.
      apt.cardEnter(tl, "#chip-d", 20.78);
      apt.cardEnter(tl, "#chip-u", 22.92);
      apt.cardEnter(tl, "#chip-c", 24.78);
      apt.cardEnter(tl, "#chip-b", 27.54);

      // ── GIVEN card - opens right as variable definitions start.
      tl.fromTo("#card-given .solution-card",
        { y: 280, scale: 0.92, opacity: 0 },
        { y: 280, scale: 1, opacity: 1, duration: 0.55, ease: "back.out(1.4)" },
        GIVEN_TIME);
      apt.textReveal(tl, "#card-given .math");

      // ── DOWNSTREAM ADD demo (39.08-45.62s, "current helps... speed = B + C")
      // - boat glides right, B-badge swaps B → B+C, formula-tag spells the rule.
      tl.to("#boat-unit", { x: 780, duration: 5.5, ease: "power1.out" }, 39.08);
      wakeFlicker(tl, 39.08, 45.62);
      tl.to("#b-state-solo1", { opacity: 0, duration: 0.25 }, 41.12);
      tl.to("#b-state-sum", { opacity: 1, duration: 0.25 }, 41.12);
      apt.cardEnter(tl, "#formula-downstream", 41.6);
      apt.emphasize(tl, "#formula-downstream", 43.28);

      // ── TURN (45.62-45.96s)
      tl.to("#boat-unit", { scaleY: 0.94, duration: 0.18, ease: "power2.out", yoyo: true, repeat: 1 }, 45.62);
      tl.to("#boat-icon", { scaleX: -1, duration: 0.4, ease: "power2.inOut" }, 45.7);
      tl.to("#b-state-sum", { opacity: 0, duration: 0.25 }, 45.96);
      tl.to("#b-state-solo2", { opacity: 1, duration: 0.25 }, 45.96);

      // ── UPSTREAM SUBTRACT demo (45.96-59.08s, "slows down... B − C")
      // - boat glides back left, current resists (judder), B-badge swaps
      // B → B−C, formula-tag spells the rule.
      tl.to("#boat-unit", { x: 150, duration: 6.0, ease: "power1.inOut" }, 45.96);
      boatJudder(tl, 45.96, 58.5, 2.0);
      wakeFlicker(tl, 45.96, 58.5);
      tl.to("#b-state-solo2", { opacity: 0, duration: 0.25 }, 54.40);
      tl.to("#b-state-diff", { opacity: 1, duration: 0.25 }, 54.40);
      apt.cardEnter(tl, "#formula-upstream", 54.9);
      apt.emphasize(tl, "#formula-upstream", 56.5);

      // ── PHASE 2 - Pin flow (58.5s).
      apt.pinFlow(tl, "#q-full-card", "#q-pinned", PIN_TIME);
      apt.pinFlow(tl, "#illustration", "#illus-pinned", PIN_TIME);
      apt.fadeOut(tl, "#serial-num", PIN_TIME, 0.5);

      riverFlow(tl, "#river-track-mini-front", 52, PIN_TIME + 1, RECENTER_TIME, 1.1);
      riverFlow(tl, "#river-track-mini-back", 65, PIN_TIME + 1, RECENTER_TIME, 1.8);
      apt.ambientLoop(tl, "#illus-pinned-icon", PIN_TIME + 1, RECENTER_TIME);

      // ── STEP 1 (59.8s) - downstream speed in terms of U.
      apt.morphToStack(tl, "#card-given .solution-card", "#stack-given .stack-card", PIN_TIME);
      apt.cardEnter(tl, "#card-step1 .solution-card", 59.8);
      apt.textReveal(tl, "#card-step1 .math");

      // ── STEP 2 (81.1s) - substitute B+C and B-C.
      apt.morphToStack(tl, "#card-step1 .solution-card", "#stack-step1 .stack-card", 80.8);
      apt.stackLineGrow(tl, "#line-g-1", 80.8);
      apt.cardEnter(tl, "#card-step2 .solution-card", 81.1);
      apt.textReveal(tl, "#card-step2 .math");

      // ── STEP 3 (105.9s) - solve for c using B = 18.
      apt.morphToStack(tl, "#card-step2 .solution-card", "#stack-step2 .stack-card", 105.6);
      apt.stackLineGrow(tl, "#line-1-2", 105.6);
      apt.cardEnter(tl, "#card-step3 .solution-card", 105.9);
      apt.textReveal(tl, "#card-step3 .math");

      // ── Recenter - clear illustration recap, align pinned question
      // against the completed stack, land Step 3's morph at the same time.
      apt.fadeOut(tl, "#illus-pinned", RECENTER_TIME);
      apt.recenterForOptions(tl, "#q-pinned", 160, 180, RECENTER_TIME);
      apt.morphToStack(tl, "#card-step3 .solution-card", "#stack-step3 .stack-card", RECENTER_TIME);
      apt.stackLineGrow(tl, "#line-2-3", RECENTER_TIME);

      // ── PHASE 3 - Options reveal
      apt.fadeIn(tl, "#options-reveal", 122.5);
      apt.optionsStagger(tl, ".opt-btn", 123.1);
      apt.correctPulse(tl, ".opt-btn.correct", 126.48);

      // ── END FADE - completes at 127.2 + 0.8 = 128.0s, inside every
      // clip's data-start/data-duration window (all extend to ~128.5).
      const END_FADE_TIME = 127.2;
      apt.fadeOut(tl, "#root > div", END_FADE_TIME, 0.8);

      tl.set({}, {}, 128.5);

      tl.to("#card-given .solution-card", { keyframes: { "0%": { x: 15, y: 13 }, "96.5%": { y: 280, x: 0 }, "100%": { y: 0 } }, duration: 22.967 }, 36.333);

      window.__timelines = window.__timelines || {};
      window.__timelines["root"] = tl;
    </script>
