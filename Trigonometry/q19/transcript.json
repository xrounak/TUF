{
  "duration": 40.639,
  "phrases": [
    {
      "start": 0.099,
      "end": 1.179,
      "text": "So welcome back again."
    },
    {
      "start": 1.699,
      "end": 3.119,
      "text": "It's time to solve one more problem."
    },
    {
      "start": 3.46,
      "end": 4.159,
      "text": "Now in this problem,"
    },
    {
      "start": 4.679,
      "end": 6.44,
      "text": "we need to evaluate sec square theta"
    },
    {
      "start": 6.899,
      "end": 8.099,
      "text": "minus tan square theta."
    },
    {
      "start": 8.539,
      "end": 13.539,
      "text": "This is not a calculation question. This is a direct identity question. So we only need to remember the standard"
    },
    {
      "start": 13.979,
      "end": 15.279,
      "text": "trigonometric identity."
    },
    {
      "start": 16.1,
      "end": 16.639,
      "text": "We know that"
    },
    {
      "start": 17.059,
      "end": 20.279,
      "text": "sec square theta is equal to one plus tan square theta."
    },
    {
      "start": 20.699,
      "end": 22.879,
      "text": "Now move tan square theta to the other side."
    },
    {
      "start": 23.239,
      "end": 24.179,
      "text": "So sec square theta"
    },
    {
      "start": 24.699,
      "end": 26.879,
      "text": "minus tan square theta is equal to one."
    },
    {
      "start": 27.379,
      "end": 29.76,
      "text": "That is exactly what the question is asking."
    },
    {
      "start": 30.199,
      "end": 30.539,
      "text": "Done."
    },
    {
      "start": 31.039,
      "end": 32.84,
      "text": "No value of theta is needed here."
    },
    {
      "start": 33.7,
      "end": 34.119,
      "text": "Hence,"
    },
    {
      "start": 34.559,
      "end": 38.2,
      "text": "sec square theta minus tan square theta is equal to one."
    },
    {
      "start": 38.739,
      "end": 40.639,
      "text": "So the correct option is option C."
    }
  ],
